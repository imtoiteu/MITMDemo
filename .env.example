# Copy this file to .env and fill in values if needed.
# For the demo, all defaults are fine for local-only use.

# Flask secret key (used for session signing)
# Change this in production; demo default is fine locally.
FLASK_SECRET_KEY=demo-secret-key-change-in-production

# Demo mode label displayed in the UI
DEMO_MODE_LABEL=Security Awareness Training

# HTTP server port
HTTP_PORT=5000

# HTTPS server port
HTTPS_PORT=5443

# Auto-open browser on startup (true/false)
AUTO_OPEN_BROWSER=true
